#!/bin/sh

ARCHIVE="/var/lib/gns3/library/docker-images/ceosimage-4.29.3M-docker.tar.xz"
ARCHIVE_SHA256="acf633e4bade9d22a6f1a426666401009cb618a255752f2c0389fd90a6f54c02"
IMAGE="ceosimage:GNS3"
VERSION="4.29.3M"
SOURCE_SHA256="d35da1459a4b061fce3d6789e21bae0ae6b89114c4168cd7778bb41c1859ece9"
LOG="/var/log/gns3/ceos-image.log"

wait_for_docker() {
	attempt=0
	while ! docker info >/dev/null 2>&1; do
		attempt=$((attempt + 1))
		if [ "$attempt" -ge 60 ]; then
			echo "Docker did not become ready within 60 seconds"
			return 1
		fi
		sleep 1
	done
}

validate_image() {
	test "$(docker image inspect --format \
		'{{ index .Config.Labels "org.gns3.ceos.version" }}' \
		"$IMAGE" 2>/dev/null)" = "$VERSION" &&
	test "$(docker image inspect --format \
		'{{ index .Config.Labels "org.gns3.ceos.source-sha256" }}' \
		"$IMAGE" 2>/dev/null)" = "$SOURCE_SHA256"
}

load_image() {
	wait_for_docker || return 1

	if validate_image; then
		echo "$IMAGE is already installed"
		return 0
	fi

	if docker image inspect "$IMAGE" >/dev/null 2>&1; then
		echo "$IMAGE exists but does not match the prepared image metadata"
		return 1
	fi

	if [ ! -f "$ARCHIVE" ]; then
		echo "Prepared cEOS archive is missing: $ARCHIVE"
		return 1
	fi

	printf '%s  %s\n' "$ARCHIVE_SHA256" "$ARCHIVE" |
		sha256sum -c - || return 1
	docker load -i "$ARCHIVE" || return 1
	validate_image
}

start() {
	printf 'Loading prepared cEOS image: '
	install -d -m 0755 -o gns3 -g gns3 /var/log/gns3
	if load_image >>"$LOG" 2>&1; then
		echo "OK"
	else
		echo "FAIL (see $LOG)"
		return 1
	fi
}

stop() {
	return 0
}

status() {
	wait_for_docker || return 1
	if validate_image; then
		echo "$IMAGE $VERSION is installed"
	else
		echo "$IMAGE is not installed or has unexpected metadata"
		return 1
	fi
}

case "$1" in
	start|stop|status)
		"$1"
		;;
	restart)
		stop && start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
