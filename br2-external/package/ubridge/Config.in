config BR2_PACKAGE_UBRIDGE
	bool "uBridge"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBPCAP
	help
	  Ethernet, TAP and UDP tunnel bridge used by GNS3.

	  https://github.com/GNS3/ubridge

comment "uBridge needs a toolchain w/ threads"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS
