config BR2_PACKAGE_GNS3_SERVER
	bool "GNS3 Server"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS # python-jsonschema
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_DOCKER_CLI
	select BR2_PACKAGE_DOCKER_ENGINE
	select BR2_PACKAGE_GNS3_BUSYBOX
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_PYEXPAT
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON3_UNICODEDATA
	select BR2_PACKAGE_PYTHON3_ZLIB
	select BR2_PACKAGE_PYTHON_AIOFILES
	select BR2_PACKAGE_PYTHON_AIOHTTP
	select BR2_PACKAGE_PYTHON_AIOHTTP_CORS
	select BR2_PACKAGE_PYTHON_ASYNC_TIMEOUT
	select BR2_PACKAGE_PYTHON_DISTRO
	select BR2_PACKAGE_PYTHON_GNS3_PLATFORMDIRS
	select BR2_PACKAGE_PYTHON_GNS3_SENTRY_SDK
	select BR2_PACKAGE_PYTHON_JINJA2
	select BR2_PACKAGE_PYTHON_JSONSCHEMA
	select BR2_PACKAGE_PYTHON_PSUTIL
	select BR2_PACKAGE_PYTHON_PY_CPUINFO
	select BR2_PACKAGE_PYTHON_SIX
	select BR2_PACKAGE_PYTHON_TRUSTSTORE
	select BR2_PACKAGE_QEMU
	select BR2_PACKAGE_QEMU_GUEST_AGENT
	select BR2_PACKAGE_QEMU_SYSTEM
	select BR2_PACKAGE_QEMU_TOOLS
	select BR2_PACKAGE_UBRIDGE
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_BINARIES
	select BR2_PACKAGE_VPCS
	help
	  GNS3 network emulation server.

	  https://github.com/GNS3/gns3-server

comment "GNS3 Server needs a toolchain w/ threads and host Rust support"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
