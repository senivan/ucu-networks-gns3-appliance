#!/bin/sh

DAEMON="/usr/bin/gns3server"
NAME="gns3"
PIDFILE="/run/gns3/gns3server.pid"
LOGFILE="/var/log/gns3/gns3server.log"
CONFIG="/etc/gns3/gns3_server.conf"
PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
HOME="/var/lib/gns3"
LANG="en_US.UTF-8"
LC_ALL="en_US.UTF-8"
export PATH HOME LANG LC_ALL

prepare() {
	install -d -m 0755 -o gns3 -g gns3 /run/gns3 /var/log/gns3
}

start() {
	printf 'Starting %s: ' "$NAME"
	prepare || {
		echo "FAIL"
		return 1
	}
	start-stop-daemon --start --quiet --pidfile "$PIDFILE" \
		--exec "$DAEMON" --chuid gns3:gns3 --chdir /var/lib/gns3 \
		-- --config "$CONFIG" --daemon --pid "$PIDFILE" \
		--log "$LOGFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$NAME"
	start-stop-daemon --stop --quiet --retry TERM/30/KILL/5 \
		--pidfile "$PIDFILE" --exec "$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		rm -f "$PIDFILE"
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

status() {
	if start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
		--exec "$DAEMON"; then
		echo "$NAME is running"
		return 0
	fi
	echo "$NAME is not running"
	return 3
}

restart() {
	stop && start
}

case "$1" in
	start|stop|restart|status)
		"$1"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
